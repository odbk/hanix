configuration {
    font:           "JetBrainsMono Nerd Font 10";
    show-icons:     false;
    hide-scrollbar: true;
    sidebar-mode:   false;
}

@import "colors.rasi"

window {
    background-color: @bg;
    text-color:       @fg;
    border:           2px;
    border-color:     @ac;
    border-radius:    0px;
    width:            280px;
    location:         center;
}

inputbar {
    children:         [ prompt ];
    background-color: @ac;
    text-color:       @bar;
    padding:          12px 14px;
    border:           0px;
}

prompt {
    background-color: transparent;
    text-color:       @bar;
    font:             "JetBrainsMono Nerd Font Bold 10";
}

entry {
    background-color: transparent;
    text-color:       @bar;
    placeholder:      "";
    expand:           false;
    width:            0px;
}

listview {
    background-color: @al;
    padding:          0px;
    columns:          1;
    lines:            5;
    spacing:          0px;
    cycle:            true;
    dynamic:          false;
    layout:           vertical;
}

mainbox {
    background-color: @al;
    border:           0px;
    children:         [ inputbar, listview ];
    spacing:          0px;
    padding:          0px;
}

element {
    background-color: @al;
    text-color:       @fg;
    padding:          10px 14px;
    border-radius:    0px;
}

element selected {
    background-color: @bga;
    text-color:       @ac;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    expand:           true;
    horizontal-align: 0;
    vertical-align:   0.5;
}
