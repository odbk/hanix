#!/usr/bin/env bash
# Ejecuta nixos-rebuild desde cualquier directorio.
# Uso: ./rebuild [switch|boot|test|dry-run] [argumentos extra]
FLAKE="$(dirname "$(readlink -f "$0")")"
ACTION="${1:-switch}"
shift 2>/dev/null

# Copia el hardware config local si no existe en el repo
if [ ! -f "$FLAKE/hardware-configuration.nix" ]; then
    echo "Copiando hardware-configuration.nix desde /etc/nixos..."
    cp /etc/nixos/hardware-configuration.nix "$FLAKE/hardware-configuration.nix"
fi

# Usa el hostname si existe en el flake, si no cae a #nixos
HOST=$(hostname)
CONFIGS=$(nix eval --impure --raw "path:$FLAKE#nixosConfigurations" \
  --apply 'x: builtins.concatStringsSep " " (builtins.attrNames x)' 2>/dev/null)
if echo " $CONFIGS " | grep -qw "$HOST"; then
  TARGET="path:$FLAKE#$HOST"
else
  TARGET="path:$FLAKE#nixos"
fi

sudo nixos-rebuild "$ACTION" --impure --flake "$TARGET" "$@"
EXIT=$?

exit $EXIT
